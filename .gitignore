# L'environnement du TP se reconstruit depuis requirements.txt — c'est même le TP
# « préparation de l'environnement » du Jour 1. Il pèse 20 000 fichiers.
tp-instrumentation/.venv/

__pycache__/
*.pyc

# `cours/vendor/` n'est PAS ignoré, et ne doit pas l'être : le cours est hors-ligne
# intégral, aucune page ne fait de requête réseau. Les dépendances vendorisées font
# partie du dépôt.

# Résidus d'exécution du TP (le rappel Python écrit test.txt, les tests écrivent data/)
tp-instrumentation/test.txt
tp-instrumentation/data/
# Archive étudiante générée — `outils/gen-archive-etudiant.py` la reconstruit
dist/
